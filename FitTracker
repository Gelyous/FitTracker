    <script>
        let база = JSON.parse(localStorage.getItem('FitTrackerOlegData')) || {
            план: { ккал: 2100, шаги: 5000, сон: 8, стартВес: 115, цельВес: 85 },
            факт: { вес: 115, ккал: 0, б: 0, ж: 0, у: 0, шаги: 0, сон: 0, индексСна: 3, заметки: "" },
            силовые: { жимВ:0, жимП:0, приседВ:0, приседП:0, тягаВ:0, тягаП:0, гантВ:0, гантП:0, нижнВ:0, нижнП:0, поясВ:0, поясП:0, верхВ:0, верхП:0, армВ:0, армП:0, брусВ:0, брусП:0, бицВ:0, бицП:0 },
            история: [],
            облакоИд: "OLEG-" + Math.random().toString(36).substr(2, 6).toUpperCase()
        };

        let графикБжу = null;
        let выбраннаяКартинкаBase64 = null;
        let удаляемыйDateKey = null;

        function показатьУведомление(текст, тип = 'успех') {
            const тост = document.getElementById('уведомление-тост');
            const тостТекст = document.getElementById('тост-текст');
            const тостИконка = document.getElementById('тост-иконка');
            if (!тост) return;
            
            тостТекст.innerText = текст;
            if (тип === 'ошибка') {
                тост.style.borderColor = '#ff4757';
                тостИконка.className = 'fa-solid fa-circle-exclamation';
                тостИконка.style.color = '#ff4757';
            } else {
                тост.style.borderColor = 'var(--неон-зеленый)';
                тостИконка.className = 'fa-solid fa-circle-check';
                тостИконка.style.color = 'var(--неон-зеленый)';
            }
            тост.style.display = 'flex';
            setTimeout(() => { тост.style.display = 'none'; }, 3000);
        }

        window.onload = function() {
            // Установка текущей даты по умолчанию
            const сегодня = new Date().toISOString().split('T')[0];
            const полеДаты = document.getElementById('ввод-дата');
            if (полеДаты) полеДаты.value = сегодня;

            инициализироватьДанные();
            обновитьИнтерфейс();
        };

        function обработатьВыборФото(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                выбраннаяКартинкаBase64 = e.target.result;
                document.getElementById('превью-фото').src = выбраннаяКартинкаBase64;
                document.getElementById('превью-контейнер').style.display = 'block';
                document.getElementById('кнопка-очистить-фото').style.display = 'inline-block';
                const статус = document.getElementById('статус-анализа');
                статус.style.display = 'block';
                статус.style.color = 'var(--текст-затененный)';
                статус.innerText = 'Фото прикреплено. Нажмите «Рассчитать КБЖУ с помощью ИИ».';
            };
            reader.readAsDataURL(file);
        }

        function сброситьФото() {
            выбраннаяКартинкаBase64 = null;
            document.getElementById('ввод-фото-еды').value = '';
            document.getElementById('превью-контейнер').style.display = 'none';
            document.getElementById('кнопка-очистить-фото').style.display = 'none';
            document.getElementById('статус-анализа').style.display = 'none';
        }

        async function распознатьЕдуИИ() {
            const текстЕды = document.getElementById('ввод-текст-еды').value.trim();

            if (!выбраннаяКартинкаBase64 && !текстЕды) {
                показатьУведомление("Напишите текст еды или прикрепите фото!", 'ошибка');
                return;
            }

            const статус = document.getElementById('статус-анализа');
            const кнопка = document.getElementById('кнопка-анализ');
            
            статус.style.display = 'block';
            статус.style.color = 'var(--неон-голубой)';
            статус.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ИИ определяет состав и рассчитывает КБЖУ...';
            кнопка.disabled = true;

            try {
                let parts = [];
                let инструкция = "Проанализируй описание еды и/или фото блюда/чека. Рассчитай суммарный КБЖУ (Калории, Белки, Жиры, Углеводы в граммах) для описанного объема пищи. Верни ответ строго в формате JSON: {\"dish_name\": \"Краткое название блюда или продуктов\", \"calories\": число, \"protein\": число, \"fat\": число, \"carbs\": число}";

                if (текстЕды) {
                    инструкция += `\nОписание еды пользователем: "${текстЕды}"`;
                }

                parts.push({ text: инструкция });

                if (выбраннаяКартинкаBase64) {
                    const base64Data = выбраннаяКартинкаBase64.split(',')[1];
                    const mimeType = выбраннаяКартинкаBase64.split(';')[0].split(':')[1] || 'image/jpeg';
                    parts.push({
                        inlineData: {
                            mimeType: mimeType,
                            data: base64Data
                        }
                    });
                }

                const payload = {
                    contents: [{ role: "user", parts: parts }],
                    generationConfig: {
                        responseMimeType: "application/json",
                        responseSchema: {
                            type: "OBJECT",
                            properties: {
                                "dish_name": { "type": "STRING" },
                                "calories": { "type": "NUMBER" },
                                "protein": { "type": "NUMBER" },
                                "fat": { "type": "NUMBER" },
                                "carbs": { "type": "NUMBER" }
                            },
                            required: ["dish_name", "calories", "protein", "fat", "carbs"]
                        }
                    }
                };

                const result = await вызовGeminiСПовторами(payload);
                const candidateText = result.candidates?.[0]?.content?.parts?.[0]?.text;

                if (!candidateText) {
                    throw new Error("Не удалось разобрать ответ от ИИ.");
                }

                const parsed = JSON.parse(candidateText);

                const protein = Math.round(parsed.protein || 0);
                const fat = Math.round(parsed.fat || 0);
                const carbs = Math.round(parsed.carbs || 0);
                const calories = Math.round(parsed.calories || (protein * 4 + fat * 9 + carbs * 4));

                document.getElementById('ввод-б').value = protein;
                document.getElementById('ввод-ж').value = fat;
                document.getElementById('ввод-у').value = carbs;
                document.getElementById('ввод-ккал').value = calories;

                // Добавление к текущему дню
                база.факт.б = (база.факт.б || 0) + protein;
                база.факт.ж = (база.факт.ж || 0) + fat;
                база.факт.у = (база.факт.у || 0) + carbs;
                база.факт.ккал = (база.факт.ккал || 0) + calories;

                const заметкиПоле = document.getElementById('ввод-заметки');
                const записьОБлюде = `${parsed.dish_name || 'Прием пищи'} (+${calories} ккал, Б:${protein}г, Ж:${fat}г, У:${carbs}г)`;
                if (заметкиПоле.value) {
                    заметкиПоле.value += ` | ${записьОБлюде}`;
                } else {
                    заметкиПоле.value = записьОБлюде;
                }
                база.факт.заметки = заметкиПоле.value;

                localStorage.setItem('FitTrackerOlegData', JSON.stringify(база));
                обновитьИнтерфейс();
                сохранитьВИсторию();

                статус.style.color = 'var(--неон-зеленый)';
                статус.innerHTML = `<i class="fa-solid fa-circle-check"></i> Зафиксировано: <b>${parsed.dish_name}</b> (+${calories} ккал / Б:${protein}г Ж:${fat}г У:${carbs}г)`;

            } catch (err) {
                console.error(err);
                статус.style.color = '#ff4757';
                статус.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Ошибка расчетов. Проверьте соединение и попробуйте еще раз.';
            } finally {
                кнопка.disabled = false;
            }
        }

        async function вызовGeminiСПовторами(payload) {
            const apiKey = "";
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            let delay = 1000;

            for (let attempt = 0; attempt < 3; attempt++) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (!response.ok) throw new Error(`HTTP error ${response.status}`);
                    return await response.json();
                } catch (e) {
                    if (attempt === 2) throw e;
                    await new Promise(r => setTimeout(r, delay));
                    delay *= 2;
                }
            }
        }

        function инициализироватьДанные() {
            if (!база.история) база.история = [];
            
            if (база.история.length === 0) {
                база.история = [
                    {
                        dateStr: "22 Июля 2026",
                        dateKey: "2026-07-22",
                        вес: 115.0,
                        ккал: 2050,
                        б: 160, ж: 70, у: 195,
                        шаги: 5200,
                        сон: 7.5,
                        индексСна: 4,
                        заметки: "Старт программы. Силовая тренировка верха."
                    }
                ];
            }

            document.getElementById('код-облака').innerText = база.облакоИд;
            document.getElementById('поле-кода').value = база.облакоИд;

            document.getElementById('план-ккал').value = база.план.ккал;
            document.getElementById('план-шаги').value = база.план.шаги;
            document.getElementById('план-сон').value = база.план.сон;

            загрузитьДанныеНаДату();

            for (let ключ in база.силовые) {
                let эл = document.getElementById('сил-' + ключ);
                if(эл) эл.value = база.силовые[ключ] || "";
            }
        }

        function загрузитьДанныеНаДату() {
            const выбраннаяДата = document.getElementById('ввод-дата')?.value || new Date().toISOString().split('T')[0];
            const запись = база.история.find(item => item.dateKey === выбраннаяДата);

            if (запись) {
                document.getElementById('ввод-вес').value = запись.вес || "";
                document.getElementById('ввод-ккал').value = запись.ккал || "";
                document.getElementById('ввод-б').value =  запись.б || "";
                document.getElementById('ввод-ж').value =  запись.ж || "";
                document.getElementById('ввод-у').value =  запись.у || "";
                document.getElementById('ввод-шаги').value = запись.шаги || "";
                document.getElementById('ввод-сон').value = запись.сон || "";
                document.getElementById('ввод-оценка-сна').value = запись.индексСна || 3;
                document.getElementById('ввод-заметки').value = запись.заметки || "";
            } else if (выбраннаяДата === new Date().toISOString().split('T')[0]) {
                document.getElementById('ввод-вес').value = база.факт.вес || "";
                document.getElementById('ввод-ккал').value = база.факт.ккал || "";
                document.getElementById('ввод-б').value =  база.факт.б || "";
                document.getElementById('ввод-ж').value =  база.факт.ж || "";
                document.getElementById('ввод-у').value =  база.факт.у || "";
                document.getElementById('ввод-шаги').value = база.факт.шаги || "";
                document.getElementById('ввод-сон').value = база.факт.сон || "";
                document.getElementById('ввод-оценка-сна').value = база.факт.индексСна || 3;
                document.getElementById('ввод-заметки').value = база.факт.заметки || "";
            } else {
                document.getElementById('ввод-вес').value = "";
                document.getElementById('ввод-ккал').value = "";
                document.getElementById('ввод-б').value = "";
                document.getElementById('ввод-ж').value = "";
                document.getElementById('ввод-у').value = "";
                document.getElementById('ввод-шаги').value = "";
                document.getElementById('ввод-сон').value = "";
                document.getElementById('ввод-оценка-сна').value = 3;
                document.getElementById('ввод-заметки').value = "";
            }
        }

        function обновитьИнтерфейс() {
            document.getElementById('показ-вес').innerText = база.факт.вес;
            document.getElementById('показ-калории-план').innerText = база.план.ккал;
            document.getElementById('показ-калории-факт').innerText = база.факт.ккал;

            let маркер = document.getElementById('маркер-калорий');
            let статус = document.getElementById('статус-дефицита');
            let процент = 50;

            if (база.факт.ккал < база.план.ккал) {
                let откл = ((база.план.ккал - база.факт.ккал) / база.план.ккал) * 50;
                процент = Math.max(5, 50 - откл);
                статус.innerText = "Дефицит сохранен";
                статус.style.color = "#00ff87";
            } else if (база.факт.ккал > база.план.ккал) {
                let откл = ((база.факт.ккал - база.план.ккал) / база.план.ккал) * 50;
                процент = Math.min(95, 50 + откл);
                статус.innerText = "Превышение плана";
                статус.style.color = "#ff4757";
            } else {
                процент = 50;
                статус.innerText = "Идеальное попадание";
                статус.style.color = "#fff";
            }
            маркер.style.left = процент + "%";

            let рассчетШагов = Math.min(226, 226 - ((база.факт.шаги || 0) / база.план.шаги) * 226);
            document.getElementById('кольцо-шагов').style.strokeDashoffset = рассчетШагов;
            document.getElementById('круг-шаги-текст').innerText = база.факт.шаги || 0;

            let рассчетСна = Math.min(226, 226 - ((база.факт.сон || 0) / база.план.сон) * 226);
            document.getElementById('кольцо-сна').style.strokeDashoffset = рассчетСна;
            document.getElementById('круг-сон-текст').innerText = (база.факт.сон || 0) + "ч";
            document.getElementById('круг-индекс-сна').innerText = база.факт.индексСна || 3;

            document.getElementById('легенда-б').innerText = (база.факт.б || 0) + "г";
            document.getElementById('легенда-ж').innerText = (база.факт.ж || 0) + "г";
            document.getElementById('легенда-у').innerText = (база.факт.у || 0) + "г";

            // Обновление списка силовых на дашборде
            let силКонтейнер = document.getElementById('дашборд-силовые-список');
            if (силКонтейнер) {
                const главные = [
                    { k: 'жим', n: 'Жим лежа' },
                    { k: 'присед', n: 'Приседания' },
                    { k: 'тяга', n: 'Становая' },
                    { k: 'арм', n: 'Армейский жим' }
                ];
                let html = '';
                главные.forEach(ex => {
                    let w = база.силовые[ex.k + 'В'] || 0;
                    let p = база.силовые[ex.k + 'П'] || 0;
                    html += `
                        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--граница); border-radius: 12px; padding: 10px 12px;">
                            <div style="font-size: 0.8rem; color: var(--текст-затененный); font-weight: 600;">${ex.n}</div>
                            <div style="font-size: 1.15rem; font-weight: 800; color: ${w > 0 ? 'var(--неон-зеленый)' : 'var(--текст-затененный)'}; margin-top: 4px;">
                                ${w > 0 ? `${w} кг × ${p}` : '—'}
                            </div>
                        </div>
                    `;
                });
                силКонтейнер.innerHTML = html;
            }

            строитьДиаграмму(база.факт.б, база.факт.ж, база.факт.у);
            сгенерироватьТекстОтчета();
            отобразитьИсторию();
        }

        function отобразитьИсторию() {
            const контейнер = document.getElementById('список-истории');
            if (!контейнер) return;

            if (!база.история || база.история.length === 0) {
                контейнер.innerHTML = '<div style="color:var(--текст-затененный); text-align:center; padding:20px;">Записи за прошлые дни отсутствуют</div>';
                return;
            }

            // Сортировка по дате (свежие сверху)
            база.история.sort((a, b) => b.dateKey.localeCompare(a.dateKey));

            let html = '';
            база.история.forEach((rec) => {
                html += `
                    <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--граница); border-radius: 14px; padding: 15px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                            <span style="font-weight:800; color:var(--неон-голубой); font-size:1rem;"><i class="fa-regular fa-calendar"></i> ${rec.dateStr}</span>
                            <span style="font-weight:800; color:var(--неон-зеленый); font-size:1.1rem;">${rec.вес} кг</span>
                        </div>
                        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:8px; font-size:0.85rem; background:rgba(0,0,0,0.2); padding:8px 12px; border-radius:8px; margin-bottom:8px;">
                            <div>🔥 <b>${rec.ккал}</b> ккал</div>
                            <div>🏃 <b>${rec.шаги}</b> шагов</div>
                            <div>😴 <b>${rec.сон}ч</b> (Оценка: ${rec.индексСна}/5)</div>
                        </div>
                        <div style="font-size:0.8rem; color:var(--текст-затененный); margin-bottom:6px;">
                            Б: <b style="color:#00ff87">${rec.б}г</b> | Ж: <b style="color:#00f2fe">${rec.ж}г</b> | У: <b style="color:#ff4757">${rec.у}г</b>
                        </div>
                        ${rec.заметки ? `<div style="font-size:0.8rem; color:#c4d1e6; font-style:italic; background:rgba(255,255,255,0.02); padding:6px 10px; border-radius:6px; border-left:2px solid var(--неон-голубой); margin-bottom:10px;"><i class="fa-solid fa-quote-left" style="font-size:0.65rem; color:var(--неон-голубой);"></i> ${rec.заметки}</div>` : ''}
                        
                        <div style="display:flex; gap:10px; border-top: 1px solid rgba(255,255,255,0.05); padding-top:10px;">
                            <button class="кнопка" style="padding: 7px 12px; font-size: 0.8rem; background: rgba(0, 242, 254, 0.1); border: 1px solid var(--неон-голубой); color: var(--неон-голубой); box-shadow: none;" onclick="редактироватьОтчет('${rec.dateKey}')">
                                <i class="fa-solid fa-pen-to-square"></i> Редактировать
                            </button>
                            <button class="кнопка" style="padding: 7px 12px; font-size: 0.8rem; background: rgba(255, 71, 87, 0.1); border: 1px solid #ff4757; color: #ff4757; box-shadow: none;" onclick="запроситьУдаление('${rec.dateKey}')">
                                <i class="fa-solid fa-trash-can"></i> Удалить
                            </button>
                        </div>
                    </div>
                `;
            });
            контейнер.innerHTML = html;
        }

        function редактироватьОтчет(dateKey) {
            const полеДаты = document.getElementById('ввод-дата');
            if (полеДаты) полеДаты.value = dateKey;
            загрузитьДанныеНаДату();
            
            // Переключение на вкладку ввода
            document.querySelectorAll('.вкладка-контент').forEach(el => el.classList.remove('актив'));
            document.querySelectorAll('.пункт-меню').forEach(el => el.classList.remove('актив'));
            document.getElementById('вкл-ввод').classList.add('актив');
            
            // Активировать кнопку ввода
            const кнопки = document.querySelectorAll('.пункт-меню');
            if (кнопки[1]) кнопки[1].classList.add('актив');

            показатьУведомление(`Загружен отчет за ${dateKey}`);
        }

        function запроситьУдаление(dateKey) {
            удаляемыйDateKey = dateKey;
            const запись = база.история.find(i => i.dateKey === dateKey);
            const текст = запись ? `Вы действительно хотите удалить отчет за ${запись.dateStr}?` : 'Удалить этот отчет?';
            document.getElementById('текст-подтверждения-удаления').innerText = текст;
            document.getElementById('окно-удаления').classList.add('открыта');
        }

        function закрытьУдаление() {
            document.getElementById('окно-удаления').classList.remove('открыта');
            удаляемыйDateKey = null;
        }

        function подтвердитьУдаление() {
            if (!удаляемыйDateKey) return;

            база.история = база.история.filter(i => i.dateKey !== удаляемыйDateKey);
            
            // Если удалили сегодняшнюю дату - сбрасываем факт
            const сегодня = new Date().toISOString().split('T')[0];
            if (удаляемыйDateKey === сегодня) {
                база.факт = { вес: база.факт.вес, ккал: 0, б: 0, ж: 0, у: 0, шаги: 0, сон: 0, индексСна: 3, заметки: "" };
            }

            localStorage.setItem('FitTrackerOlegData', JSON.stringify(база));
            закрытьУдаление();
            обновитьИнтерфейс();
            показатьУведомление("Отчет успешно удален");
        }

        function переключитьВкладку(имяВкладки) {
            document.querySelectorAll('.вкладка-контент').forEach(el => el.classList.remove('актив'));
            document.querySelectorAll('.пункт-меню').forEach(el => el.classList.remove('актив'));
            
            document.getElementById('вкл-' + имяВкладки).classList.add('актив');
            event.currentTarget.classList.add('актив');
            
            if(имяВкладки === 'отчет') сгенерироватьТекстОтчета();
            if(имяВкладки === 'история') отобразитьИсторию();
        }

        function сохранитьПлан() {
            база.план.ккал = parseInt(document.getElementById('план-ккал').value) || 2100;
            база.план.шаги = parseInt(document.getElementById('план-шаги').value) || 5000;
            база.план.сон = parseInt(document.getElementById('план-сон').value) || 8;
            
            localStorage.setItem('FitTrackerOlegData', JSON.stringify(база));
            обновитьИнтерфейс();
            показатьУведомление("План успешно сохранен!");
        }

        function сохранитьДневник() {
            const датаЗначение = document.getElementById('ввод-дата')?.value || new Date().toISOString().split('T')[0];
            const объектДаты = new Date(датаЗначение + 'T00:00:00');
            const dateStr = объектДаты.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

            const вес = parseFloat(document.getElementById('ввод-вес').value) || база.факт.вес;
            let b = parseInt(document.getElementById('ввод-б').value) || 0;
            let j = parseInt(document.getElementById('ввод-ж').value) || 0;
            let u = parseInt(document.getElementById('ввод-у').value) || 0;
            let ккал = 0;

            if(b > 0 || j > 0 || u > 0) {
                ккал = (b * 4) + (j * 9) + (u * 4);
                document.getElementById('ввод-ккал').value = ккал;
            } else {
                ккал = parseInt(document.getElementById('ввод-ккал').value) || 0;
            }

            const шаги = parseInt(document.getElementById('ввод-шаги').value) || 0;
            const сон = parseFloat(document.getElementById('ввод-сон').value) || 0;
            const индексСна = parseInt(document.getElementById('ввод-оценка-сна').value) || 3;
            const заметки = document.getElementById('ввод-заметки').value;

            // Формируем новую запись
            const запись = {
                dateStr: dateStr,
                dateKey: датаЗначение,
                вес: вес,
                ккал: ккал,
                б: b, ж: j, у: u,
                шаги: шаги,
                сон: сон,
                индексСна: индексСна,
                заметки: заметки
            };

            // Обновление истории
            if (!база.история) база.история = [];
            const индекс = база.история.findIndex(item => item.dateKey === датаЗначение);
            if (индекс >= 0) {
                база.история[индекс] = запись;
            } else {
                база.история.unshift(запись);
            }

            // Если сохраняем за "сегодня", также обновляем базу.факт для дашборда
            const сегодня = new Date().toISOString().split('T')[0];
            if (датаЗначение === сегодня) {
                база.факт = { вес, ккал, б: b, ж: j, у: u, шаги, сон, индексСна, заметки };
            }

            localStorage.setItem('FitTrackerOlegData', JSON.stringify(база));
            обновитьИнтерфейс();
            показатьУведомление(`Отчет за ${dateStr} сохранен!`);
        }

        function сохранитьСиловые() {
            for (let ключ in база.силовые) {
                let эл = document.getElementById('сил-' + ключ);
                if(эл) база.силовые[ключ] = parseInt(эл.value) || 0;
            }
            localStorage.setItem('FitTrackerOlegData', JSON.stringify(база));
            показатьУведомление("Силовые показатели успешно обновлены!");
        }

        function строитьДиаграмму(б, ж, у) {
            let ctx = document.getElementById('диаграммаБжу').getContext('2d');
            if (графикБжу) графикБжу.destroy();

            let данные = [б || 0, ж || 0, у || 0];
            if (!б && !ж && !у) данные = [1, 1, 1];

            графикБжу = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: данные,
                        backgroundColor: ['#00ff87', '#00f2fe', '#ff4757'],
                        borderWidth: 0
                    }]
                },
                options: {
                    cutout: '75%',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });
        }

        function сгенерироватьТекстОтчета() {
            let бжуСтрока = база.факт.б ? `${база.факт.ккал} ккал (Б: ${база.факт.б}г, Ж: ${база.факт.ж}г, У: ${база.факт.у}г)` : `${база.факт.ккал} ккал`;
            let текст = `📊 ФАКТ И ПРОГРЕСС ЗА ДЕНЬ:\nТекущий вес: ${база.факт.вес} кг (Цель: 85 кг)\n\n🍗 ПИТАНИЕ:\nФакт КБЖУ: ${бжуСтрока} \n[План: ${база.план.ккал} ккал]\n\n😴 МОНИТОРИНГ СНА:\nВремя сна: ${база.факт.сон} ч [План: ${база.план.сон} ч]\nОценка качества: ${база.факт.индексСна || 3}/5\n\n🏃 АКТИВНОСТЬ:\nШаги за сутки: ${база.факт.шаги} из ${база.план.шаги}`;

            let естьСиловые = false;
            let блокСил = `\n\n💪 СИЛОВЫЕ ПОКАЗАТЕЛИ:`;
            const имена = {
                жим: "Жим штанги лежа", присед: "Приседания со штангой", тяга: "Становая тяга",
                гант: "Жим гантелей", нижн: "Тяга нижнего блока", пояс: "Тяга блока к поясу",
                верх: "Тяга верхнего блока", арм: "Армейский жим стоя", брус: "Отжимания на брусьях", биц: "Бицепс"
            };

            for(let к in имена) {
                if(база.силовые[к+'В'] > 0) {
                    естьСиловые = true;
                    блокСил += `\n* ${имена[к]}: ${база.силовые[к+'В']} кг × ${база.силовые[к+'П']}`;
                }
            }
            if(естьСиловые) текст += блокСил;
            if(база.факт.заметки && база.факт.заметки.trim().length > 0) {
                текст += `\n\n📝 ЗАМЕТКИ И САМОЧУВСТВИЕ:\n${база.факт.заметки}`;
            }
            document.getElementById('блок-отчета').innerText = текст;
        }

        function скопироватьОтчет() {
            let текст = document.getElementById('блок-отчета').innerText;
            navigator.clipboard.writeText(текст).then(() => {
                показатьУведомление("Отчет скопирован в буфер обмена!");
            });
        }

        function открытьОблако() { document.getElementById('окно-облака').classList.add('открыта'); }
        function закрытьОблако() { document.getElementById('окно-облака').classList.remove('открыта'); }
    </script>
</body>
</html>
