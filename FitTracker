<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FitTracker Pro - Олег</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --фон-главный: #060913;
            --фон-карта: rgba(10, 22, 44, 0.8);
            --неон-зеленый: #00ff87;
            --неон-голубой: #00f2fe;
            --текст-главный: #ffffff;
            --текст-затененный: #708099;
            --граница: rgba(0, 242, 254, 0.2);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--фон-главный);
            background-image: radial-gradient(circle at 50% 0%, #0c2340 0%, #060913 70%);
            color: var(--текст-главный);
            min-height: 100vh;
            padding-bottom: 90px;
            overflow-x: hidden;
        }

        .шапка {
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--граница);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(6, 9, 19, 0.85);
        }

        .шапка h1 {
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: var(--неон-зеленый);
            text-shadow: 0 0 12px rgba(0, 255, 135, 0.3);
            margin-left: 70px; /* Отступ для предотвращения перекрытия логотипом Gemini */
            transition: margin 0.3s ease;
        }

        .облако-статус {
            background: rgba(0, 255, 135, 0.1);
            border: 1px solid var(--неон-зеленый);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            color: var(--неон-зеленый);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 0 10px rgba(0, 255, 135, 0.2);
        }

        .контейнер {
            max-width: 1650px;
            margin: 0 auto;
            padding: 20px;
        }

        .сетка-дашборда {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        @media (min-width: 768px) {
            .сетка-дашборда {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (min-width: 1200px) {
            .сетка-дашборда {
                grid-template-columns: repeat(2, 1fr);
                gap: 25px;
            }
        }

        @media (min-width: 1400px) {
            .сетка-дашборда {
                grid-template-columns: repeat(3, 1fr);
                gap: 25px;
            }
        }

        .стекло-карта {
            background: var(--фон-карта);
            border: 1px solid var(--граница);
            border-radius: 20px;
            padding: 22px;
            backdrop-filter: blur(16px);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        @media (min-width: 1024px) {
            .шапка h1 {
                font-size: 1.5rem;
            }

            .стекло-карта {
                padding: 30px;
                border-radius: 24px;
                min-height: 250px;
            }

            .заголовок-карты {
                font-size: 1.05rem;
                margin-bottom: 20px;
            }

            .холст-контейнер {
                width: 160px;
                height: 160px;
            }

            .круг-индикатор {
                width: 125px;
                height: 125px;
            }

            .круг-значение {
                font-size: 1.4rem;
            }

            .легенда-строка {
                font-size: 1.05rem;
            }

            .градиент-линия {
                height: 28px;
                border-radius: 14px;
            }

            .ползунок-маркер {
                height: 30px;
                width: 8px;
            }
        }

        .заголовок-карты {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--текст-затененный);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
        }

        .заголовок-карты i {
            color: var(--неон-голубой);
        }

        .шкала-контейнер {
            margin: 15px 0;
            position: relative;
        }

        .градиент-линия {
            height: 22px;
            border-radius: 11px;
            background: linear-gradient(to right, #4a0e17 0%, #00ff87 50%, #ff4757 100%);
            position: relative;
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
        }

        .ползунок-маркер {
            position: absolute;
            top: -1px;
            width: 6px;
            height: 24px;
            background: #ffffff;
            box-shadow: 0 0 10px #ffffff, 0 0 5px var(--неон-голубой);
            border-radius: 3px;
            transition: left 0.3s ease;
        }

        .бжу-блок {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .холст-контейнер {
            width: 120px;
            height: 120px;
            position: relative;
            flex-shrink: 0;
        }

        .бжу-легенда {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-grow: 1;
        }

        .легенда-строка {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .маркер-цвета {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .кольцо-блок {
            display: flex;
            justify-content: space-around;
            align-items: center;
            text-align: center;
        }

        .круг-индикатор {
            position: relative;
            width: 90px;
            height: 90px;
        }

        .круг-индикатор svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        .круг-значение {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.1rem;
            font-weight: 800;
        }

        .сетка-упражнений {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }
        @media (min-width: 600px) {
            .сетка-упражнений {
                grid-template-columns: 1fr 1fr;
            }
        }

        .поле-ввода {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--граница);
            border-radius: 10px;
            padding: 10px 12px;
            color: #ffffff;
            width: 100%;
            font-size: 0.95rem;
            transition: border 0.2s;
        }

        .поле-ввода:focus {
            outline: none;
            border-color: var(--неон-голубой);
        }

        button.кнопка {
            background: linear-gradient(135deg, var(--неон-зеленый) 0%, #00b35c 100%);
            border: none;
            border-radius: 12px;
            padding: 14px;
            color: #060913;
            font-weight: 800;
            font-size: 0.95rem;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 4px 15px rgba(0, 255, 135, 0.3);
        }

        .навигация {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(10, 22, 44, 0.95);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--граница);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            z-index: 1000;
        }

        .пункт-меню {
            background: none;
            border: none;
            color: var(--текст-затененный);
            font-size: 0.75rem;
            font-weight: 700;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            width: 60px;
        }

        .пункт-меню i {
            font-size: 1.2rem;
        }

        .пункт-меню.актив {
            color: var(--неон-зеленый);
            text-shadow: 0 0 10px rgba(0, 255, 135, 0.5);
        }

        .вкладка-контент {
            display: none;
        }

        .вкладка-контент.актив {
            display: block;
        }

        .текст-отчета {
            background: rgba(0,0,0,0.4);
            border: 1px solid var(--граница);
            border-radius: 10px;
            padding: 12px;
            font-family: monospace;
            font-size: 0.85rem;
            white-space: pre-wrap;
            margin-bottom: 15px;
            color: #c4d1e6;
        }

        .модалка {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(5px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            padding: 20px;
        }
        .модалка.открыта { display: flex; }

        #уведомление-тост {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            background: rgba(10, 22, 44, 0.95);
            border: 1px solid var(--неон-зеленый);
            color: var(--текст-главный);
            padding: 12px 20px;
            border-radius: 14px;
            backdrop-filter: blur(12px);
            box-shadow: 0 4px 20px rgba(0, 255, 135, 0.3);
            display: none;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
    </style>
</head>
<body>

    <div id="уведомление-тост">
        <i id="тост-иконка" class="fa-solid fa-circle-check" style="color: var(--неон-зеленый);"></i>
        <span id="тост-текст">Сообщение</span>
    </div>

    <div class="шапка">
        <h1>Здравия желаю, Олег</h1>
        <div class="облако-статус" onclick="открытьОблако()">
            <i class="fa-solid fa-cloud"></i> <span id="код-облака">Синхронизация</span>
        </div>
    </div>

    <div class="контейнер">
        
        <div id="вкл-дашборд" class="вкладка-контент актив">
            <div class="сетка-дашборда">
                
                <!-- Контроль веса -->
                <div class="стекло-карта">
                    <div class="заголовок-карты"><i class="fa-solid fa-weight-scale"></i> Контроль массы тела</div>
                    <div style="font-size: 2.8rem; font-weight: 800; text-align: center; margin: 15px 0;">
                        <span id="показ-вес">115</span> кг
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: var(--текст-затененный);">
                        <span>Старт: 115 кг</span>
                        <span style="color: var(--неон-зеленый); font-weight: bold;">Цель: 85 кг</span>
                    </div>
                </div>

                <!-- Шкала калорий -->
                <div class="стекло-карта">
                    <div class="заголовок-карты"><i class="fa-solid fa-gauge-high"></i> Баланс энергии (Калории)</div>
                    <div style="display: flex; justify-content: space-between; align-items: baseline;">
                        <span style="font-size: 2.2rem; font-weight: 800;" id="показ-калории-факт">0</span>
                        <span style="color: var(--текст-затененный); font-size: 1rem;">План: <span id="показ-калории-план">2100</span> ккал</span>
                    </div>
                    
                    <div class="шкала-контейнер">
                        <div class="градиент-линия">
                            <div class="ползунок-маркер" id="маркер-калорий" style="left: 50%;"></div>
                        </div>
                    </div>
                    <div style="text-align: center; font-size: 0.95rem; font-weight: bold;" id="статус-дефицита">В пределах нормы</div>
                </div>

                <!-- Диаграмма БЖУ -->
                <div class="стекло-карта">
                    <div class="заголовок-карты"><i class="fa-solid fa-chart-pie"></i> Пропорции нутриентов (БЖУ)</div>
                    <div class="бжу-блок">
                        <div class="холст-контейнер">
                            <canvas id="диаграммаБжу"></canvas>
                        </div>
                        <div class="бжу-легенда">
                            <div class="легенда-строка">
                                <span><span class="маркер-цвета" style="background:#00ff87"></span>Белки</span>
                                <span id="легенда-б">0г</span>
                            </div>
                            <div class="легенда-строка">
                                <span><span class="маркер-цвета" style="background:#00f2fe"></span>Жиры</span>
                                <span id="легенда-ж">0г</span>
                            </div>
                            <div class="легенда-строка">
                                <span><span class="маркер-цвета" style="background:#ff4757"></span>Угл.</span>
                                <span id="легенда-у">0г</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Шаги и Сон -->
                <div class="стекло-карта">
                    <div class="заголовок-карты"><i class="fa-solid fa-person-walking"></i> Шаги и Сон</div>
                    <div class="кольцо-блок">
                        <div>
                            <div class="круг-индикатор">
                                <svg viewBox="0 0 90 90" style="width:100%; height:100%;"><circle cx="45" cy="45" r="36" stroke="rgba(255,255,255,0.08)" stroke-width="7" fill="none"/>
                                <circle id="кольцо-шагов" cx="45" cy="45" r="36" stroke="var(--неон-голубой)" stroke-width="7" fill="none" stroke-dasharray="226" stroke-dashoffset="226"/></svg>
                                <div class="круг-значение" id="круг-шаги-текст">0</div>
                            </div>
                            <div style="font-size:0.85rem; margin-top:8px; color:var(--текст-затененный); font-weight:bold;">Шаги</div>
                        </div>
                        <div>
                            <div class="круг-индикатор">
                                <svg viewBox="0 0 90 90" style="width:100%; height:100%;"><circle cx="45" cy="45" r="36" stroke="rgba(255,255,255,0.08)" stroke-width="7" fill="none"/>
                                <circle id="кольцо-сна" cx="45" cy="45" r="36" stroke="var(--неон-зеленый)" stroke-width="7" fill="none" stroke-dasharray="226" stroke-dashoffset="226"/></svg>
                                <div class="круг-значение" id="круг-сон-текст">0ч</div>
                            </div>
                            <div style="font-size:0.85rem; margin-top:8px; color:var(--текст-затененный); font-weight:bold;">Сон (Индекс: <span id="круг-индекс-сна">-</span>)</div>
                        </div>
                    </div>
                </div>

                <!-- Силовые показатели (Виджет на Дашборде) -->
                <div class="стекло-карта">
                    <div class="заголовок-карты"><i class="fa-solid fa-dumbbell"></i> Силовые показатели</div>
                    <div id="дашборд-силовые-список" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 5px;">
                        <!-- Заполняется динамически -->
                    </div>
                </div>

            </div>
        </div>

        <div id="вкл-ввод" class="вкладка-контент">
            <div class="стекло-карта">
                <div class="заголовок-карты"><i class="fa-solid fa-pen-to-square"></i> Ввод результатов за день</div>
                
                <div style="margin-bottom: 15px; background: rgba(0, 242, 254, 0.05); padding: 12px; border-radius: 12px; border: 1px solid var(--граница);">
                    <label style="font-size:0.85rem; color:var(--неон-голубой); font-weight:700; display:block; margin-bottom:6px;">
                        <i class="fa-regular fa-calendar-days"></i> Дата отчета:
                    </label>
                    <input type="date" id="ввод-дата" class="поле-ввода" style="color-scheme: dark; font-weight:bold;" onchange="загрузитьДанныеНаДату()">
                </div>

                <!-- Единый ИИ-блок ввода питания -->
                <div style="background: rgba(0, 242, 254, 0.05); border: 1px dashed var(--неон-голубой); border-radius: 14px; padding: 15px; margin-bottom: 18px;">
                    <div style="font-size: 0.95rem; color: var(--неон-голубой); font-weight: 700; margin-bottom: 8px; display:flex; align-items:center; gap:8px;">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Умный учет питания (ИИ Gemini)
                    </div>
                    <p style="font-size: 0.8rem; color: var(--текст-затененный); margin-bottom: 12px;">
                        Опишите словами, что вы съели, или загрузите фото/чек — ИИ сам определит и занесет КБЖУ.
                    </p>
                    
                    <div style="margin-bottom: 12px;">
                        <label style="font-size:0.8rem; color:var(--текст-затененный); display:block; margin-bottom:4px;">Что вы съели?</label>
                        <textarea id="ввод-текст-еды" class="поле-ввода" rows="3" placeholder="Например: Скушал 2 вареных яйца, овсянку на молоке 250г и кофе с сахаром..."></textarea>
                    </div>

                    <input type="file" id="ввод-фото-еды" accept="image/*" style="display:none;" onchange="обработатьВыборФото(event)">
                    
                    <div style="display:flex; gap:10px; margin-bottom: 10px;">
                        <button class="кнопка" type="button" style="background: rgba(0, 242, 254, 0.1); border: 1px solid var(--неон-голубой); color: var(--неон-голубой); box-shadow: none; padding: 10px; font-size: 0.85rem;" onclick="document.getElementById('ввод-фото-еды').click()">
                            <i class="fa-solid fa-camera"></i> Прикрепить фото / чек
                        </button>
                        <button id="кнопка-очистить-фото" class="кнопка" type="button" style="display:none; background: rgba(255, 71, 87, 0.1); border: 1px solid #ff4757; color: #ff4757; box-shadow: none; padding: 10px; font-size: 0.85rem; width: auto;" onclick="сброситьФото()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <div id="превью-контейнер" style="display:none; margin-bottom: 12px; text-align:center;">
                        <img id="превью-фото" style="max-width: 100%; max-height: 180px; border-radius: 10px; border: 1px solid var(--граница); object-fit: cover;" />
                    </div>

                    <button id="кнопка-анализ" class="кнопка" type="button" style="background: linear-gradient(135deg, var(--неон-голубой) 0%, #0088ff 100%); font-size: 0.9rem;" onclick="распознатьЕдуИИ()">
                        <i class="fa-solid fa-brain"></i> Рассчитать КБЖУ с помощью ИИ
                    </button>

                    <div id="статус-анализа" style="font-size: 0.85rem; font-weight: 600; margin-top: 10px; display: none;"></div>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="font-size:0.85rem; color:var(--текст-затененный); display:block; margin-bottom:4px;">Текущий вес (кг)</label>
                    <input type="number" step="0.1" id="ввод-вес" class="поле-ввода" placeholder="115.0">
                </div>

                <!-- Скрытые поля для расчетов ИИ -->
                <input type="hidden" id="ввод-б">
                <input type="hidden" id="ввод-ж">
                <input type="hidden" id="ввод-у">
                <input type="hidden" id="ввод-ккал">

                <div style="margin-bottom: 12px;">
                    <label style="font-size:0.85rem; color:var(--текст-затененный); display:block; margin-bottom:4px;">Пройдено шагов</label>
                    <input type="number" id="ввод-шаги" class="поле-ввода" placeholder="5000">
                </div>

                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:15px;">
                    <div>
                        <label style="font-size:0.8rem; color:var(--текст-затененный);">Часы сна</label>
                        <input type="number" step="0.5" id="ввод-сон" class="поле-ввода" placeholder="8">
                    </div>
                    <div>
                        <label style="font-size:0.8rem; color:var(--текст-затененный);">Оценка сна (1-5)</label>
                        <select id="ввод-оценка-сна" class="поле-ввода" style="background: #0a162c;">
                            <option value="5">5 — Отлично</option>
                            <option value="4">4 — Хорошо</option>
                            <option value="3" selected>3 — Нормально</option>
                            <option value="2">2 — Плохо</option>
                            <option value="1">1 — Ужасно</option>
                        </select>
                    </div>
                </div>

                <div style="margin-bottom:15px;">
                    <label style="font-size:0.8rem; color:var(--текст-затененный); display:block; margin-bottom:4px;">Заметки по самочувствию</label>
                    <textarea id="ввод-заметки" class="поле-ввода" rows="2" placeholder="Заметки по еде, тренировке, усталости..."></textarea>
                </div>

                <button class="кнопка" onclick="сохранитьДневник()"><i class="fa-solid fa-check"></i> Сохранить отчет за выбранную дату</button>
            </div>
        </div>

        <div id="вкл-силовые" class="вкладка-контент">
            <div class="стекло-карта">
                <div class="заголовок-карты"><i class="fa-solid fa-dumbbell"></i> Дневник силовых показателей</div>
                
                <div class="сетка-упражнений" style="margin-bottom: 20px;">
                    <div>
